<main class="content content-channels">
	<header>
		<h2>Kick Live Streams</h2>
	</header>
	{{#if loading}}
		<p>Loading Kick live streams...</p>
	{{else}}
		{{#if error}}
			<p role="alert">{{error}}</p>
		{{/if}}
		<div class="kick-stream-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1.25rem;padding:1rem 0">
			{{#each streams as |stream|}}
				<div class="kick-stream-card" style="min-width:0">
					<button type="button" {{action "play" stream.slug}} title="Play {{stream.channel}} in VLC" style="display:block;width:100%;padding:0;border:0;background:transparent;cursor:pointer;text-align:left;color:inherit">
						<div style="font-size:15px;font-weight:600;text-align:center;padding:0 0 8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{#if stream.avatar}}<img src={{stream.avatar}} alt="" loading="lazy" style="width:30px;height:30px;border-radius:50%;border:2px solid #53fc18;object-fit:cover;vertical-align:middle;margin-right:8px">{{/if}}{{stream.channel}}</div>
						<div style="aspect-ratio:16/9;background:rgba(128,128,128,.18);overflow:hidden;border-radius:5px;position:relative">
							{{#if stream.thumbnail}}
								<img src={{stream.thumbnail}} alt="" style="width:100%;height:100%;object-fit:cover">
							{{else}}
								<div style="display:flex;align-items:center;justify-content:center;height:100%;font-size:1.2rem">Kick</div>
							{{/if}}
							<span style="position:absolute;top:8px;left:8px;background:#d12d36;color:white;padding:2px 6px;border-radius:3px;font-size:11px;font-weight:bold">LIVE</span>
						</div>
						<div style="display:flex;justify-content:flex-end;align-items:center;padding:7px 2px 4px;opacity:.85;font-size:13px"><span aria-label="Viewers">◉ {{stream.viewers}} viewers</span></div>
						<div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{stream.title}}</div>
						{{#if stream.category}}
							<div style="opacity:.7;font-size:12px;margin-top:3px">{{stream.category}}</div>
						{{/if}}
					</button>
				</div>
			{{else}}
				{{#unless error}}
					<p>No live streams found.</p>
				{{/unless}}
			{{/each}}
		</div>
		{{#if hasMore}}
			<div class="kick-streams-load-sentinel" style="height:1px"></div>
			<button type="button" {{action "loadMore"}} disabled={{loadingMore}}>
				{{#if loadingMore}}Loading more...{{else}}Load More Streams{{/if}}
			</button>
		{{/if}}
	{{/if}}
</main>
