<main class="content content-channels">
	<header>
		<h2>Kick: {{categoryName}}</h2>
	</header>
	<p>{{#link-to "kickGames"}}← All Kick Games{{/link-to}}</p>
	{{#if loading}}
		<p>Loading live channels...</p>
	{{else}}
		{{#if error}}<p role="alert">{{error}}</p>{{/if}}
		<div class="kick-stream-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1.25rem;padding:1rem 0">
			{{#each streams as |stream|}}
				<div class="kick-stream-card" style="min-width:0">
					<button type="button" {{action "play" stream.slug}} title="Play {{stream.channel}} in VLC" style="display:block;width:100%;padding:0;border:0;background:transparent;cursor:pointer;text-align:left;color:inherit">
						<div style="aspect-ratio:16/9;background:rgba(128,128,128,.18);overflow:hidden;border-radius:5px;position:relative">
							{{#if stream.thumbnail}}
								<img src={{stream.thumbnail}} alt="" style="width:100%;height:100%;object-fit:cover">
							{{else}}
								<div style="display:flex;align-items:center;justify-content:center;height:100%">Kick</div>
							{{/if}}
							<span style="position:absolute;top:8px;left:8px;background:#d12d36;color:white;padding:2px 6px;border-radius:3px;font-size:11px;font-weight:bold">LIVE</span>
							<span style="position:absolute;bottom:8px;left:8px;background:rgba(0,0,0,.8);color:white;padding:3px 6px;border-radius:3px;font-size:12px">{{stream.viewers}} viewers</span>
						</div>
						<div style="padding:8px 0 2px;font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{stream.channel}}</div>
						<div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{stream.title}}</div>
					</button>
					<button type="button" {{action "openBrowser" stream.slug}} style="margin-top:6px">Open in Browser</button>
				</div>
			{{else}}
				{{#unless error}}<p>No live channels found in this category.</p>{{/unless}}
			{{/each}}
		</div>
	{{/if}}
</main>
