<fieldset>
	<legend>Kick Account</legend>
	<p>Sign in with your personal Kick developer app. On Windows, your login is
		encrypted for your user account and restored when you reopen the app.</p>
	<p>Enter your Client Secret only in this local app. Never share it or commit it to GitHub.</p>
	<div class="form-group">
		<label for="kick-client-id">Client ID</label>
		{{input id="kick-client-id" value=clientId class="form-control"}}
	</div>
	<div class="form-group">
		<label for="kick-redirect-uri">Redirect URI</label>
		{{input id="kick-redirect-uri" value=redirectUri class="form-control"}}
	</div>
	<div class="form-group">
		<label for="kick-client-secret">Client Secret (encrypted on Windows for saved login)</label>
		{{input id="kick-client-secret" type="password" value=clientSecret
			class="form-control" autocomplete="off"}}
	</div>
	<p>
		<button type="button" class="btn btn-primary" disabled={{busy}}
			{{action "signIn"}}>Sign in with Kick</button>
		<button type="button" class="btn btn-default"
			{{action "clearSecret"}}>Clear Secret</button>
		<button type="button" class="btn btn-default"
			{{action "disconnect"}}>Disconnect</button>
	</p>
	<p role="status"><strong>Status:</strong> {{status}}</p>
	{{#if accountName}}
		<p><strong>Signed in as:</strong> {{accountName}}</p>
	{{/if}}
	<p>Account follows are not synced yet. This step tests account authorization only.</p>
</fieldset>
