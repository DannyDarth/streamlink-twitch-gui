<main class="content content-games">
	<header><h2>Kick Games</h2></header>
	{{#if loading}}
		<p>Loading Kick categories...</p>
	{{else}}
		{{#if error}}
			<p role="alert">{{error}}</p>
		{{/if}}
		<div class="kick-game-grid">
			{{#each games as |game|}}
				<div class="kick-game-card">
					<div class="kick-game-cover">
						{{#if game.image}}
							<img src={{game.image}} alt="" loading="lazy">
						{{else}}
							<span class="kick-game-placeholder fa fa-gamepad" aria-hidden="true"></span>
						{{/if}}
						<div class="kick-game-viewers">{{game.viewers}} viewers</div>
					</div>
					<div class="kick-game-name" title={{game.name}}>{{game.name}}</div>
				</div>
			{{else}}
				{{#unless error}}
					<p>No Kick categories were returned.</p>
				{{/unless}}
			{{/each}}
		</div>
	{{/if}}
</main>
